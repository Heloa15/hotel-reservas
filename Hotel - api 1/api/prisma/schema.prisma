generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Quarto {
  id            Int       @id @default(autoincrement())
  numeroQuarto  String    @unique
  tipoQuarto    String

  reservas      Reserva[]

}

model Reserva {
  id            Int       @id @default(autoincrement())
  hospede       String
  dataEntrada   DateTime
  dataSaida     DateTime

  quartoId      Int
  quarto        Quarto    @relation(fields: [quartoId], references: [id], onDelete: Cascade)

}